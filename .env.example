# Neon Postgres connection string. Use the POOLED endpoint (the host containing
# "-pooler") for the application, so serverless instances share connections.
#
# Local development: copy this file to .env.local and paste your string.
# Vercel: set the same variable in Project Settings -> Environment Variables.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# The single shared account that guards the app, exchanged at /sign-in for a
# signed session cookie. ALL THREE are required in production: without them the
# deployment refuses every request rather than serving your essays unprotected.
# Local development skips the gate while they are unset.
#
# AUTH_SECRET signs the session cookie - generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Rotating it signs everyone out.
AUTH_USERNAME="ethan"
AUTH_PASSWORD="generate-a-long-random-one"
AUTH_SECRET="generate-a-long-random-one"
