# Neon Postgres connection string. Use the POOLED endpoint (the host containing
# "-pooler") for the application, so serverless instances share connections.
#
# Local development: copy this file to .env.local and paste your string.
# Vercel: set the same variable in Project Settings -> Environment Variables.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# HTTP Basic auth in front of the entire app. REQUIRED in production: without
# both values set, the deployment refuses every request rather than serving
# your essays unprotected. Local development skips the gate when they are unset.
BASIC_AUTH_USER="ethan"
BASIC_AUTH_PASSWORD="generate-a-long-random-one"
