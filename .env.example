# Neon Postgres connection string. Use the POOLED endpoint (the host containing
# "-pooler") for the application, so serverless instances share connections.
#
# Local development: copy this file to .env.local and paste your string.
# Vercel: set the same variable in Project Settings -> Environment Variables.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
