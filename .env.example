# Neon Postgres connection string. Use the POOLED endpoint (the host containing
# "-pooler") for the application, so serverless instances share connections.
#
# Local development: copy this file to .env.local and paste your string.
# Vercel: set the same variable in Project Settings -> Environment Variables.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Signs the session cookie. REQUIRED in production: without it no session can
# be verified, so the app refuses every request rather than serving essays
# unprotected. Local development runs ungated while it is unset.
#
# Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Rotating it signs everyone out.
AUTH_SECRET="generate-a-long-random-one"

# Travila API key for the AI "Shorten" essay feature (src/lib/travila.ts).
# Read lazily, server-side only - never sent to the client and never logged.
# Unset means shortenEssay() returns a clean "not-configured" error and the
# Shorten controls show that message instead of calling out to Travila.
TRAVILA_API_KEY=""
